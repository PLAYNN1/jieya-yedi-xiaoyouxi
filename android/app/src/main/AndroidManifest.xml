<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- All game resources are bundled. No network or device-data permissions. -->
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true"
        android:hardwareAccelerated="true" android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
